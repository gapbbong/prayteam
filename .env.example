# Web Push (VAPID) keys — required by both:
#   - netlify/functions/notify.js
#   - next-app/src/app/api/notify/route.js
#
# Generate a new pair with:
#   npx web-push generate-vapid-keys
#
# Set the real values in your deployment platform's dashboard
# (Netlify: Site settings > Environment variables / Vercel: Project > Settings > Environment Variables).
# Never commit the real values to git.

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
